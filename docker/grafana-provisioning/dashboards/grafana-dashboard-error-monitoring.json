{
  "id": null,
  "title": "Diavgeia Error Monitoring",
    "tags": ["diavgeia", "errors", "monitoring"],
    "style": "dark",
    "timezone": "browser",
    "templating": {
      "list": [
        {
          "current": {
            "selected": true,
            "text": "production",
            "value": "production"
          },
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "definition": "label_values(environment)",
          "hide": 0,
          "includeAll": true,
      "allValue": ".*",
          "label": "Environment",
          "multi": false,
          "name": "environment",
          "options": [
            {
              "selected": true,
              "text": "production",
              "value": "production"
            }
          ],
          "query": "label_values(environment)",
          "refresh": 2,
          "regex": "",
          "skipUrlSync": false,
          "sort": 1,
          "type": "query"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Error Rate by Service",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (service_name) (rate({environment=~\"$environment\"} |~ \"ERROR|Exception|Error\"[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.1
                },
                {
                  "color": "red",
                  "value": 1
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        }
      },
      {
        "id": 2,
        "title": "Warning Rate by Service",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (service_name) (rate({environment=~\"$environment\"} |~ \"WARN|WARNING\"[5m]))",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 0.5
                },
                {
                  "color": "red",
                  "value": 2
                }
              ]
            }
          }
        },
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        }
      },
      {
        "id": 3,
        "title": "Recent Errors",
        "type": "logs",
        "targets": [
          {
            "expr": "{environment=~\"$environment\"} |~ \"ERROR|Exception|Error\"",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 16,
          "w": 24,
          "x": 0,
          "y": 8
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 4,
        "title": "Recent Warnings",
        "type": "logs",
        "targets": [
          {
            "expr": "{environment=~\"$environment\"} |~ \"WARN|WARNING\"",
            "refId": "A"
          }
        ],
        "gridPos": {
          "h": 16,
          "w": 24,
          "x": 0,
          "y": 24
        },
        "options": {
          "showTime": true,
          "showLabels": true,
          "wrapLogMessage": true,
          "enableLogDetails": true,
          "sortOrder": "Descending"
        }
      }
    ],
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "refresh": "30s",
    "schemaVersion": 30,
  "version": 1
}
